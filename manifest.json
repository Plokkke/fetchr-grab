{
  "manifest_version": 3,
  "name": "Fetchr Grab",
  "version": "2.4",
  "description": "Detect download links and send them to Fetchr",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "Fetchr Grab",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/links.js", "content-detect.js"],
      "run_at": "document_idle"
    }
  ]
}
